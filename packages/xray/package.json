{
  "name": "@hueest/xray",
  "version": "0.9.0",
  "description": "Auto-captured skeleton loading screens for Vite — capture the structure, ship the plate.",
  "keywords": [
    "loading",
    "placeholder",
    "skeleton",
    "skeleton-screen",
    "vite",
    "vite-plugin"
  ],
  "homepage": "https://xray-js.dev",
  "bugs": "https://github.com/hueest/xray/issues",
  "license": "MIT",
  "author": "Stefan Maric",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hueest/xray.git"
  },
  "files": [
    "dist",
    "virtual.d.ts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react/dev": {
      "types": "./dist/react.dev.d.ts",
      "import": "./dist/react.dev.js"
    },
    "./internal/client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./internal/hud": {
      "types": "./dist/hud.d.ts",
      "import": "./dist/hud.js"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chenglou/pretext": "1.0.0",
    "devalue": "6.0.3",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@solidjs/web": "2.0.0-rc.21",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "happy-dom": "21.0.4",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "2.0.0-rc.21",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-solid": "3.0.0-next.27",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "vite": ">=7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  }
}
