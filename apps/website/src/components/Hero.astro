---
/* Overrides Starlight's splash Hero: a centered lockup (wordmark + catchphrase + actions)
   above a full-bleed stage holding the before/after comparison slider. */
import { Image } from 'astro:assets'
import ComparisonDemo from './ComparisonDemo.astro'
import { GITHUB, INSTALL, LLMS_TXT } from '../lib/site.ts'
import logo from '../assets/logo.png'

const { data } = Astro.locals.starlightRoute.entry
const { title = data.title, tagline } = data.hero || {}
---

<section class="hero">
  <div class="hero-lockup">
    {
      /* Lit like a light box: dim, then a fluorescent stutter-on, then a rare flicker (pure
        CSS). The WebP is the LCP element (eager, high priority); quality stays high so the
        screen blend doesn't reveal lifted blacks as a box. */
    }
    <h1 id="_top" class="wordmark" data-page-title>
      <Image
        class="lightbox"
        src={logo}
        alt={title}
        width={1344}
        height={756}
        format="webp"
        quality={90}
        loading="eager"
        fetchpriority="high"
      />
    </h1>

    <p class="catchphrase">
      See through the <span class="flesh">meat</span> of your components and capture anatomically correct
      <span class="bone">skeletons</span>.
    </p>
    {tagline && <div class="tagline" set:html={tagline} />}

    <div class="hero-actions">
      <button
        class="install-chip"
        type="button"
        data-copy={INSTALL}
        aria-label={`Copy install command: ${INSTALL}`}
      >
        <span class="install-prompt" aria-hidden="true">$</span>
        <code>{INSTALL}</code>
        <span class="install-feedback" aria-hidden="true">Copy</span>
      </button>
      <a
        class="llms-link"
        href={LLMS_TXT}
        aria-label="llms.txt: machine-readable docs for AI coding agents"
      >
        <svg
          viewBox="0 0 16 16"
          width="14"
          height="14"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 1.75h4.5L12 5.25V14.25H4z"></path>
          <path d="M8.25 1.75V5.25H11.75"></path>
          <path d="M6 8.5h4M6 11h3"></path>
        </svg>
        <code>llms.txt</code>
      </a>
      <a class="hero-cta" href={GITHUB}>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="currentColor">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"
          ></path>
        </svg>
        <span>View on GitHub</span>
      </a>
    </div>
  </div>

  <div class="hero-stage">
    <ComparisonDemo />
  </div>
</section>

<style>
  .hero {
    /* --poke: how far the demo rises over the divider (~a quarter of its height); the
       gap reserves that lift plus breathing room so it never crowds the actions. */
    --poke: clamp(5rem, 11vw, 10rem);
    display: flex;
    flex-direction: column;
    gap: calc(var(--poke) + var(--xrw-block));
    padding-block: clamp(1.5rem, 5vmin, 3.5rem);
  }

  .hero-lockup {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--xrw-space-lg);
    max-width: 54rem;
    margin-inline: auto;
  }

  .wordmark {
    /* A definite width is what lets .lightbox's aspect-ratio reserve the box from first
       paint: in a centered flex column the image's own width:100% is otherwise indefinite,
       so the box collapses until the image loads (the CLS). */
    width: 100%;
    max-width: 42rem;
    margin: 0 auto;
    /* Backdrop for the blend: an ancestor's isolation:isolate cuts the page bg from the
       blending group, so mix-blend-mode needs a surface painted here to composite against. */
    background: var(--xrw-bg);
  }
  .lightbox {
    display: block;
    width: 100%;
    height: auto;
    /* With the wordmark's definite width, this reserves the box from the first layout. */
    aspect-ratio: 1672 / 941;
    /* screen drops the logo's black into the dark hero, leaving only the glow. */
    mix-blend-mode: screen;
    /* Opacity drives the light-box turn-on + idle flicker (with screen, low = off). */
    opacity: 1;
    animation:
      lightbox-on 0.7s 0.6s backwards,
      lightbox-flicker 14s 1.5s infinite;
    /* steps() snaps between opacities — a flicker, not a fade. */
    animation-timing-function: steps(1, jump-end);
  }
  /* Light mode is the page negative. Opt the wordmark OUT of the global raster re-invert
     (filter:none) but keep screen, so the single root invert flips the lit glyphs into a
     dark inked mark on the light field — the wordmark rides the film like the rest of the
     UI. (multiply here collapsed bright glyphs over the dark backdrop to near-white = a
     ghost.) */
  :global(:root[data-theme='light']) .lightbox {
    filter: none;
  }
  /* Ignition: dark holds punctuated by strikes, like a tube catching. */
  @keyframes lightbox-on {
    0% {
      opacity: 0.04;
    }
    22% {
      opacity: 0.95;
    }
    26% {
      opacity: 0.05;
    }
    48% {
      opacity: 1;
    }
    52% {
      opacity: 0.08;
    }
    70% {
      opacity: 1;
    }
    75% {
      opacity: 0.3;
    }
    80% {
      opacity: 1;
    }
    100% {
      opacity: 1;
    }
  }
  /* Steady most of the cycle, then two fast stutter-bursts (keyframes ~25ms apart snap). */
  @keyframes lightbox-flicker {
    0%,
    29.8%,
    31.4%,
    67.8%,
    68.9%,
    100% {
      opacity: 1;
    }
    30% {
      opacity: 0.25;
    }
    30.2% {
      opacity: 1;
    }
    30.5% {
      opacity: 0.5;
    }
    30.7% {
      opacity: 1;
    }
    31% {
      opacity: 0.18;
    }
    31.2% {
      opacity: 1;
    }
    68% {
      opacity: 0.4;
    }
    68.2% {
      opacity: 1;
    }
    68.5% {
      opacity: 0.6;
    }
    68.7% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox {
      animation: none;
      opacity: 1;
    }
  }

  .catchphrase {
    margin: 0;
    max-width: 44ch;
    font-family: var(--xrw-font-display);
    font-weight: 700;
    font-size: var(--xrw-display);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--xrw-bone);
    text-shadow: var(--xrw-glow-head);
    text-wrap: balance;
    /* "meat" crimson (flesh), "skeletons" steel (bones); both invert with the page. Each
       keeps the general --xrw-glow-head (the shared white/black glow) and layers a halo of its
       OWN hue on top, so they sit consistently with the rest of the catchphrase but carry
       their colour. */
    & .flesh {
      color: var(--xrw-crimson);
      text-shadow:
        0 0 18px color-mix(in oklab, var(--xrw-crimson), transparent 55%),
        var(--xrw-glow-head);
    }
    & .bone {
      color: var(--xrw-accent);
      text-shadow:
        0 0 18px color-mix(in oklab, var(--xrw-accent), transparent 55%),
        var(--xrw-glow-head);
    }
  }
  .tagline {
    max-width: 54ch;
    font-size: var(--xrw-text-md);
    color: var(--sl-color-gray-2);
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--xrw-space-xs) var(--xrw-space-sm);
  }
  .hero-cta,
  .install-chip,
  .llms-link {
    display: inline-flex;
    align-items: center;
    gap: var(--xrw-space-xs);
    /* min-height (not height) so the pill grows with text-zoom instead of clipping. */
    min-height: 2.5rem;
    padding: 0 var(--xrw-space-sm);
    border: 1px solid var(--xrw-line);
    border-radius: var(--xrw-radius-md);
    background: color-mix(in oklab, var(--xrw-surface), transparent 35%);
    color: var(--xrw-bone);
    font-size: var(--xrw-text-sm);
    line-height: 1;
    text-decoration: none;
    /* Hover (accent edge + glow + flicker), focus ring, and transition are promoted to a
       site-wide rule in theme.css that targets these classes plus every other button. */
  }
  .hero-cta {
    font-weight: 600;
  }
  @media (pointer: coarse) {
    .hero-cta,
    .install-chip,
    .llms-link {
      min-height: var(--xrw-touch-min);
    }
  }
  .hero-cta svg {
    flex: none;
    opacity: 0.85;
  }

  .install-chip {
    cursor: copy;
    font-family: var(--xrw-font-mono);
    & code {
      background: none;
      border: 0;
      padding: 0;
      font: inherit;
      color: var(--xrw-bone);
    }
    &.is-copied .install-feedback {
      color: var(--xrw-accent);
    }
  }
  .install-prompt {
    color: var(--xrw-accent);
    opacity: 0.8;
  }
  .install-feedback {
    margin-left: var(--xrw-space-2xs);
    padding-left: var(--xrw-space-xs);
    border-left: 1px solid var(--xrw-line);
    font-family: var(--xrw-font-body);
    font-size: var(--xrw-text-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--xrw-muted);
    transition: color var(--xrw-dur-state) var(--xrw-ease);
  }

  .llms-link {
    font-family: var(--xrw-font-mono);
    & svg {
      flex: none;
      opacity: 0.85;
    }
    & code {
      background: none;
      border: 0;
      padding: 0;
      font: inherit;
      font-size: var(--xrw-text-sm);
      color: inherit;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-cta,
    .install-chip,
    .llms-link {
      transition: none;
    }
  }

  .hero-stage {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding: 0 clamp(1rem, 4vw, 3rem);
    display: flex;
    justify-content: center;
    border-top: 1px solid var(--xrw-line);
    background:
      radial-gradient(
        120% 90% at 50% 0%,
        color-mix(in oklab, var(--xrw-accent), transparent 92%),
        transparent 60%
      ),
      color-mix(in oklab, var(--xrw-bg), black 35%);
  }
  /* Lift the demo so it straddles the divider: .compare is the flex child here, inherits
     --poke, and paints over the band border. :global because it's a child component's class. */
  .hero-stage :global(.compare) {
    position: relative;
    margin-top: calc(-1 * var(--poke));
  }
</style>

<script>
  // Click-to-copy on the install chip (progressive enhancement: selectable without JS).
  for (const chip of document.querySelectorAll<HTMLButtonElement>('.install-chip')) {
    const feedback = chip.querySelector('.install-feedback')
    let timer = 0
    chip.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(chip.dataset.copy || '')
        chip.classList.add('is-copied')
        if (feedback) feedback.textContent = 'Copied'
        clearTimeout(timer)
        timer = window.setTimeout(() => {
          chip.classList.remove('is-copied')
          if (feedback) feedback.textContent = 'Copy'
        }, 1600)
      } catch {
        /* clipboard blocked (insecure context / denied) — no-op, text stays selectable */
      }
    })
  }
</script>
