---
/* The hero's before/after comparison, product subject and all. Server-renders the product
   (the "after"); a client script captures it into a Plate and reveals the rendered skeleton
   (the "before") clipped to a draggable seam — pixel-faithful, so the seam morphs
   bones↔content. No framework: the bones render straight from core (renderPlateHtml → one
   HTML string) and the slider is plain DOM, so the demo ships no client framework. The
   product lives inline rather than as its own component — capture, the shared box, and the
   scoped styles bind the two too tightly to keep them apart. */
---

<div
  class="compare"
  id="xr-compare"
  role="group"
  aria-label="Interactive demo: skeleton vs. live component"
>
  {/* The "after": the real product page. Its visible "headings" are deliberately NOT <h*> —
      the live side sits in the a11y tree, so real headings would inject "Difference Engine
      No. 2" / "You might also like" into the page outline before the first content <h2>. */}
  <div class="compare-after">
    <article class="product">
      <div class="product-main">
        <div class="product-gallery"></div>
        <div class="product-info">
          <span class="product-eyebrow">Analytical Engine Co.</span>
          <div class="product-title">Difference Engine No. 2</div>
          <div class="product-price">$1,200</div>
          <div class="product-rating">
            ★★★★½ <span class="product-reviews">(128 reviews)</span>
          </div>
          <p class="product-desc">
            Hand-cranked, 8,000 parts, computes polynomial tables to 31 digits without a single bug.
          </p>
          <button class="product-buy" type="button" tabindex="-1">
            Add to cart
          </button>
        </div>
      </div>

      <section class="product-similar">
        <div class="product-similar__heading">You might also like</div>
        <ul class="carousel">
          <li class="product-card">
            <div class="product-card__img"></div>
            <span class="product-card__name">Pascaline</span>
            <span class="product-card__price">$980</span>
          </li>
          <li class="product-card">
            <div class="product-card__img"></div>
            <span class="product-card__name">Arithmometer</span>
            <span class="product-card__price">$1,450</span>
          </li>
          <li class="product-card">
            <div class="product-card__img"></div>
            <span class="product-card__name">Comptometer</span>
            <span class="product-card__price">$720</span>
          </li>
          <li class="product-card">
            <div class="product-card__img"></div>
            <span class="product-card__name">Curta Type I</span>
            <span class="product-card__price">$2,100</span>
          </li>
        </ul>
      </section>
    </article>
  </div>

  {/* The bones overlay: in the template so the scoped styles apply (a runtime-created node
      wouldn't carry Astro's scope class). Hidden until the script fills it. */}
  <div class="compare-before" aria-hidden="true" hidden></div>

  <span class="compare-tag compare-tag--before" aria-hidden="true">
    skeleton
  </span>
  <span class="compare-tag compare-tag--after" aria-hidden="true">
    live component
  </span>

  <button
    type="button"
    class="compare-handle compare-handle--hint"
    style="left: 50%"
    role="slider"
    aria-label="Drag to compare the skeleton and the live component"
    aria-controls="xr-compare"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    aria-valuetext="50% skeleton, 50% live component"
  >
    <span class="compare-grip" aria-hidden="true"></span>
  </button>
</div>

<script>
  import { captureElement, composeCss, renderPlateHtml } from '@hueest/xray/core'

  // Processed module script (Astro best practice): bundled, deferred, runs once after
  // parse. Initialise every comparison on the page; there's one today, but a global
  // script shouldn't assume that.
  for (const frame of document.querySelectorAll<HTMLElement>('.compare')) {
    initCompare(frame)
  }

  function initCompare(frame: HTMLElement) {
    const source = frame.querySelector<HTMLElement>('.compare-after')
    const handle = frame.querySelector<HTMLButtonElement>('.compare-handle')
    const before = frame.querySelector<HTMLElement>('.compare-before')
    if (!source || !handle || !before) return

    let pos = 50 // % from the left; skeleton shown left of it
    let dragging = false

    const setPos = (p: number) => {
      pos = Math.min(100, Math.max(0, p))
      const n = Math.round(pos)
      before.style.clipPath = `inset(0 ${100 - pos}% 0 0)`
      handle.style.left = `${pos}%`
      handle.setAttribute('aria-valuenow', String(n))
      handle.setAttribute('aria-valuetext', `${n}% skeleton, ${100 - n}% live component`)
    }

    // Fill the overlay with the captured bones and reveal it (kept hidden in the markup so
    // it never flashes an empty box before the first capture), then re-clip to the seam.
    const draw = (html: string) => {
      before.innerHTML = html
      before.hidden = false
      setPos(pos)
    }

    // Capture once laid out (fonts applied), then re-capture on width change — the live
    // component reflows on resize, so a load-only capture would go stale. Debounced.
    const capture = () => {
      if (source.children.length === 0) return
      try {
        // Two-artifact contract: capture hands back the tree and its css
        // separately; the standard composition (BASE_CSS + plate rules) is the
        // caller's — composeCss — since this demo renders outside the plugin.
        const { plate, css } = captureElement(Array.from(source.children), {
          name: 'product-page',
        })
        draw(renderPlateHtml(plate, composeCss(css)))
      } catch {
        /* capture failed (e.g. detached) — the slider just shows the component */
      }
    }

    const ready = document.fonts?.ready ?? Promise.resolve()
    ready.then(() => {
      requestAnimationFrame(() => {
        // Narrow viewports collapse the product to one column, where a centred 50% seam
        // slices text down the middle (reads as a bug). Bias hard toward the skeleton so
        // the live side is a thin clean edge.
        if (window.matchMedia('(max-width: 50rem)').matches) pos = 72
        capture()
        let lastWidth = Math.round(source.getBoundingClientRect().width)
        let timer = 0
        const observer = new ResizeObserver(() => {
          const width = Math.round(source.getBoundingClientRect().width)
          if (width === lastWidth) return
          lastWidth = width
          clearTimeout(timer)
          timer = window.setTimeout(() => requestAnimationFrame(capture), 150)
        })
        observer.observe(source)
      })
    })

    const setFromClientX = (clientX: number) => {
      const rect = frame.getBoundingClientRect()
      setPos(((clientX - rect.left) / rect.width) * 100)
    }
    const stopHint = () => handle.classList.remove('compare-handle--hint')

    frame.addEventListener('pointerdown', (e) => {
      dragging = true
      stopHint()
      frame.setPointerCapture?.(e.pointerId)
      setFromClientX(e.clientX)
    })
    frame.addEventListener('pointermove', (e) => {
      if (dragging) setFromClientX(e.clientX)
    })
    const endDrag = () => {
      dragging = false
    }
    frame.addEventListener('pointerup', endDrag)
    frame.addEventListener('pointercancel', endDrag)

    // WAI-ARIA APG slider keys: arrows step, Page keys jump, Home/End pin; up/right = more live.
    handle.addEventListener('keydown', (e) => {
      let handled = true
      switch (e.key) {
        case 'ArrowLeft':
        case 'ArrowDown':
          setPos(pos - 4)
          break
        case 'ArrowRight':
        case 'ArrowUp':
          setPos(pos + 4)
          break
        case 'PageDown':
          setPos(pos - 10)
          break
        case 'PageUp':
          setPos(pos + 10)
          break
        case 'Home':
          setPos(0)
          break
        case 'End':
          setPos(100)
          break
        default:
          handled = false
      }
      if (handled) {
        e.preventDefault()
        stopHint()
      }
    })
  }
</script>

<style>
  .compare {
    position: relative;
    width: min(100%, 50rem);
    margin: 0 auto;
    border-radius: var(--xrw-radius-md);
    /* Clip the grip to the frame so it tucks into the rounded edge at 0/100% instead of
       spilling outside (the outer glow box-shadow paints beyond the box, so it survives). */
    overflow: hidden;
    box-shadow: var(--xrw-glow-box-out), var(--xrw-glow-box-in);
    touch-action: none;
    user-select: none;
    cursor: ew-resize;
  }

  .compare-after {
    border-radius: inherit;
    overflow: hidden;
  }

  /* The skeleton, overlaid and clipped to the left of the seam (pixel-faithful, so it lands
     exactly on the component beneath). clip-path (the seam) is set inline from the slider. */
  .compare-before {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
    background: var(--xrw-bg);
  }

  .compare-tag {
    position: absolute;
    top: 0.7rem;
    z-index: 3;
    padding: 0.18rem 0.55rem;
    border-radius: var(--xrw-radius-full);
    background: color-mix(in oklab, var(--xrw-bg), transparent 10%);
    border: 1px solid var(--xrw-line);
    font-family: var(--xrw-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: var(--xrw-muted);
    pointer-events: none;
  }
  .compare-tag--before {
    left: 0.7rem;
  }
  .compare-tag--after {
    right: 0.7rem;
  }

  .compare-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 4;
    transform: translateX(-50%);
    width: 2px;
    padding: 0;
    border: 0;
    background: var(--xrw-accent);
    box-shadow: 0 0 12px -1px color-mix(in oklab, var(--xrw-accent), transparent 35%);
    cursor: ew-resize;
    touch-action: none;
    &:focus-visible {
      outline: 2px solid var(--xrw-accent);
      outline-offset: 4px;
    }
  }
  .compare-grip {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: var(--xrw-radius-full);
    background: var(--xrw-surface);
    border: 1px solid var(--xrw-accent);
    box-shadow: var(--xrw-glow-box-out);
    &::before {
      content: '↔';
      color: var(--xrw-accent);
      font-size: 1.05rem;
      line-height: 1;
    }
    @media (pointer: coarse) {
      width: var(--xrw-touch-min);
      height: var(--xrw-touch-min);
    }
  }

  /* One-time grip pulse inviting the drag; removed on first interaction, off under reduced motion. */
  .compare-handle--hint .compare-grip {
    animation: compare-grip-hint 1.4s var(--xrw-ease) 3;
  }
  @keyframes compare-grip-hint {
    0%,
    100% {
      transform: translate(-50%, -50%) scale(1);
      box-shadow: var(--xrw-glow-box-out);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.12);
      box-shadow: 0 0 18px -2px color-mix(in oklab, var(--xrw-accent), transparent 25%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .compare-handle--hint .compare-grip {
      animation: none;
    }
  }

  .product {
    width: 100%;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    padding: 1.5rem 1.6rem;
    background: var(--xrw-surface);
    border: 1px solid var(--xrw-line);
    border-radius: var(--xrw-radius-md);
  }

  .product-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.4rem;
  }
  .product-gallery {
    aspect-ratio: 16 / 9;
    border-radius: var(--xrw-radius-md);
    border: 1px solid var(--xrw-line);
    background:
      radial-gradient(
        130% 130% at 25% 15%,
        color-mix(in oklab, var(--xrw-accent), transparent 78%),
        transparent 55%
      ),
      var(--xrw-surface-2);
  }
  .product-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    min-width: 0;
  }
  .product-eyebrow {
    font-family: var(--xrw-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--xrw-muted);
  }
  .product-title {
    margin: 0;
    font-family: var(--xrw-font-display);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--xrw-ink);
  }
  .product-price {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--xrw-accent);
  }
  .product-rating {
    font-size: 0.9rem;
    color: var(--xrw-bone);
    white-space: nowrap;
  }
  .product-reviews {
    color: var(--xrw-muted);
  }
  .product-desc {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--xrw-muted);
  }
  .product-buy {
    margin-top: 0.35rem;
    border: 0;
    border-radius: var(--xrw-radius-sm);
    background: var(--xrw-accent);
    color: var(--xrw-bg);
    padding: 0.55rem 1.3rem;
    font: inherit;
    font-weight: 700;
  }

  .product-similar {
    padding-top: 1.3rem;
    border-top: 1px solid var(--xrw-line);
  }
  .product-similar__heading {
    margin: 0 0 0.9rem;
    font-family: var(--xrw-font-display);
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--xrw-bone);
  }
  .carousel {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.9rem;
    overflow: hidden;
  }
  .product-card {
    flex: 0 0 8.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .product-card__img {
    aspect-ratio: 4 / 3;
    border-radius: var(--xrw-radius-sm);
    border: 1px solid var(--xrw-line);
    background: var(--xrw-surface-2);
  }
  .product-card__name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--xrw-ink);
  }
  .product-card__price {
    font-size: 0.8rem;
    color: var(--xrw-muted);
  }

  @container (min-width: 28rem) {
    .product-main {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    }
    .product-gallery {
      aspect-ratio: 1 / 1;
    }
  }
</style>
