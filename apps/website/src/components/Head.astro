---
/*
 * Overrides Starlight's Head to add the Astro Fonts API <Font> tags. Starlight
 * renders <Head /> with no children (it only maps the route's `head` config),
 * so we render the default Head and then append the <Font> tags — Astro hoists
 * their preload links + @font-face/metric-fallback <style> into <head>.
 *
 * Each cssVariable matches a token theme.css consumes (--xrw-font-*), so <Font>
 * owns those variables (with metric-matched fallbacks for zero font-swap CLS)
 * and the rest of the CSS just references them.
 */
import Default from '@astrojs/starlight/components/Head.astro'
import { Font } from 'astro:assets'
---

<Default />
<Font cssVariable="--xrw-font-display" preload />
<Font cssVariable="--xrw-font-body" preload />
<Font cssVariable="--xrw-font-mono" />

{/* A wink for the curious dev who opens the console. */}
<script is:inline>
  console.log(
    '%c xray %c\nThe bones are real: serialized from your live DOM, then rendered as the skeleton.\n%c→ https://github.com/hueest/xray',
    'font:700 16px ui-monospace,monospace;background:#aeb9d6;color:#0b0e16;padding:2px 7px;border-radius:3px',
    'color:#aeb9d6;font:13px ui-monospace,monospace;line-height:1.6',
    'color:#7c8398;font:12px ui-monospace,monospace',
  )
</script>
